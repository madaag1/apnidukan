rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'madaag1@admin.apnidukan.com';
    }

    // Storefront data is public; only the authenticated administrator may edit it.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /featurePages/{pageId} {
      allow read, write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, write: if isAdmin();
    }

    // Each signed-in customer can access only their own non-sensitive profile.
    match /customers/{customerId} {
      allow create: if signedIn() && request.auth.uid == customerId;
      allow read, update, delete: if signedIn() && request.auth.uid == customerId;
    }

    match /orders/{orderId} {
      allow create: if (signedIn() && request.resource.data.customerId == request.auth.uid) || request.resource.data.customerId == 'guest';
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Everything else, including legacy plaintext admin credentials, is private.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
